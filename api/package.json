{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env src/db/migrate.ts",
    "db:seed": "node --env-file=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
